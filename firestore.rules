rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Owner-bound access for user interactions (prompts and Gemini responses)
    match /users/{userId}/interactions/{interactionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Owner-bound access for journal entries
    match /users/{userId}/entries/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Owner-bound access for user profile documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Zero insecure defaults - explicitly deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
